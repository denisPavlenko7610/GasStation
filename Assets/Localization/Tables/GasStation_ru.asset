    m_Localized: "\u041C\u0430\u0448\u0438\u043D \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u0442. \u041F\u043E\u0442\u043E\u043C \u0431\u0443\u0434\u0435\u0442 \u043D\u0430\u043F\u043B\u044B\u0432 \u2014 \u043F\u0440\u043E\u0432\u0435\u0440\u044C \u0437\u0430\u043F\u0430\u0441\u044B \u0438 \u043A\u043E\u043B\u043E\u043D\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1240195194
    m_Localized: "\u041C\u0430\u0448\u0438\u043D \u0432 2,5 \u0440\u0430\u0437\u0430 \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1240195195
    m_Localized: "\u041C\u0430\u0448\u0438\u043D \u043D\u0430 30% \u043C\u0435\u043D\u044C\u0448\u0435."
