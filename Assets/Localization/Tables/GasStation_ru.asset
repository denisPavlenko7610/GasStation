      m_Items: []
  - m_Id: 1240195284
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195285
    m_Localized: "\u0426\u0435\u043B\u044C \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0434\u043D\u044F {0}: \u0432\u044B\u043F\u043B\u0430\u0442\u0438\u0442\u044C ${1:0} (\u0432\u044B\u043F\u043B\u0430\u0447\u0435\u043D\u043E ${2:0}), \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0441\u0442\u0430\u043D\u0446\u0438\u0438 {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195286
    m_Localized: "\u041E\u0441\u0442\u0430\u0442\u043E\u043A \u0434\u043E\u043B\u0433\u0430: ${0:0}"
