  - m_Id: 1231806693
    m_Localized: "\u041E\u0442\u0437\u044B\u0432\u043E\u0432 \u043F\u043E\u043A\u0430 \u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806694
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043E\u0442\u0437\u044B\u0432\u044B:"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806695
    m_Localized: "\u0414\u043E\u0445\u043E\u0434 (\u0437\u0435\u043B\u0451\u043D\u044B\u0439) \u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u044B (\u043A\u0440\u0430\u0441\u043D\u044B\u0439) \u043F\u043E \u0434\u043D\u044F\u043C:"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806696
    m_Localized: "\u0413\u0440\u0430\u0444\u0438\u043A \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806697
    m_Localized: "\u0414\u0435\u043A\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806698
    m_Localized: "\u0444\u043B\u0430\u0433\u0438, \u0446\u0432\u0435\u0442\u044B, \u0441\u043A\u0430\u043C\u0435\u0439\u043A\u0438 \u0438 \u0433\u0438\u0440\u043B\u044F\u043D\u0434\u044B: +3% \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u0437\u0430 \u0443\u0440\u043E\u0432\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806699
    m_Localized: "\u041E\u0430\u0437\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806700
    m_Localized: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0441\u0442\u0430\u043D\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
