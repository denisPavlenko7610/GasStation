  - m_Id: 1231806825
    m_Localized: "\u0421\u0422\u0420\u041E\u0419\u041A\u0410 \u2014 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 {0} \u0438\u0437 {1} (B \u2014 \u0432\u044B\u0439\u0442\u0438)"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806826
    m_Localized: "{0}. {1} \u2014 ${2:0} (\u0441\u0442\u043E\u0438\u0442: {3})"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806827
    m_Localized: "{0}. {1} \u2014 \u0441 \u0443\u0440\u043E\u0432\u043D\u044F {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806828
    m_Localized: "\u041B\u041A\u041C \u2014 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C   \u041F\u041A\u041C \u2014 \u0443\u0431\u0440\u0430\u0442\u044C (\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0446\u0435\u043D\u044B \u043D\u0430\u0437\u0430\u0434)   Q / E \u2014 \u043F\u043E\u0432\u043E\u0440\u043E\u0442   \u043A\u043E\u043B\u0435\u0441\u043E \u2014 \u043C\u0430\u0441\u0448\u0442\u0430\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806829
    m_Localized: "\u0411\u043E\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806830
    m_Localized: "\u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u0449\u0438\u043A, \u043B\u044E\u0431\u0438\u0442 \u0434\u0438\u0437\u0435\u043B\u044C \u0438 \u043A\u043E\u0444\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806831
    m_Localized: "\u041A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E, \u0434\u0438\u0437\u0435\u043B\u044C \u0434\u043E \u043F\u043E\u043B\u043D\u043E\u0433\u043E. \u0418 \u043A\u043E\u0444\u0435 \u043F\u043E\u043A\u0440\u0435\u043F\u0447\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806832
    m_Localized: "\u0421\u0435\u043C\u044C\u0441\u043E\u0442 \u043C\u0438\u043B\u044C \u043F\u043E\u0437\u0430\u0434\u0438, \u0442\u0440\u0438\u0441\u0442\u0430 \u0432\u043F\u0435\u0440\u0435\u0434\u0438. \u0416\u0438\u0437\u043D\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806833
    m_Localized: "\u041C\u0430\u0440\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806834
    m_Localized: "\u0442\u0430\u043A\u0441\u0438\u0441\u0442\u043A\u0430, \u0437\u0430\u0435\u0437\u0436\u0430\u0435\u0442 \u043F\u043E\u0447\u0442\u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806835
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u0435\u043D\u044C\u043A\u043E, \u0443 \u043C\u0435\u043D\u044F \u043A\u043B\u0438\u0435\u043D\u0442 \u0432 \u0430\u044D\u0440\u043E\u043F\u043E\u0440\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806836
    m_Localized: "\u041E\u043F\u044F\u0442\u044C \u0432\u0435\u0441\u044C \u0433\u043E\u0440\u043E\u0434 \u043F\u0435\u0440\u0435\u043A\u043E\u043F\u0430\u043B\u0438, \u0442\u043E\u043B\u044C\u043A\u043E \u0443 \u0432\u0430\u0441 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806837
    m_Localized: "\u0421\u0435\u043C\u044C\u044F \u0418\u0432\u0430\u043D\u043E\u0432\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806838
    m_Localized: "\u0435\u0434\u0443\u0442 \u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435 \u043A \u043C\u043E\u0440\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806839
    m_Localized: "\u0414\u0435\u0442\u0438, \u0432 \u0442\u0443\u0430\u043B\u0435\u0442 \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E, \u0431\u044B\u0441\u0442\u0440\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806840
    m_Localized: "\u041F\u043E\u043C\u043E\u0435\u043C \u043C\u0430\u0448\u0438\u043D\u0443 \u2014 \u0438 \u0434\u0430\u043B\u044C\u0448\u0435, \u043E\u0442\u043F\u0443\u0441\u043A \u0436\u0434\u0451\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806841
    m_Localized: "\u0411\u0430\u0439\u043A\u0435\u0440 \u0413\u0430\u0440\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806842
    m_Localized: "\u0433\u043E\u043D\u044F\u0435\u0442 \u043F\u043E \u043F\u044F\u0442\u043D\u0438\u0446\u0430\u043C \u0438 \u0441\u0443\u0431\u0431\u043E\u0442\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806843
    m_Localized: "\u041F\u043E\u043B\u043D\u044B\u0439 \u0431\u0430\u043A \u0434\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u043E \u043F\u044F\u0442\u043E\u0433\u043E \u0434\u043B\u044F \u043C\u043E\u0435\u0439 \u043A\u0440\u0430\u0441\u043E\u0442\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806844
    m_Localized: "\u0421\u043B\u044B\u0448\u0430\u043B \u043F\u0440\u043E \u0441\u043B\u0451\u0442 \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435? \u0411\u0443\u0434\u0435\u0442 \u0433\u0440\u043E\u043C\u043A\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806845
    m_Localized: "\u0414\u0435\u0434 \u041F\u0435\u0442\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806846
    m_Localized: "\u043F\u0435\u043D\u0441\u0438\u043E\u043D\u0435\u0440, \u0437\u0430\u0435\u0437\u0436\u0430\u0435\u0442 \u0437\u0430 \u0433\u0430\u0437\u0435\u0442\u043E\u0439 \u0438 \u043A\u043E\u0444\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806847
    m_Localized: "\u0420\u0430\u043D\u044C\u0448\u0435 \u0442\u0443\u0442 \u0431\u0435\u043D\u0437\u0438\u043D \u0441\u0442\u043E\u0438\u043B \u043A\u043E\u043F\u0435\u0439\u043A\u0438, \u044D\u0445..."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806848
    m_Localized: "\u041A\u043E\u0444\u0435 \u0443 \u0432\u0430\u0441 \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u0432 \u0433\u043E\u0440\u043E\u0434\u0435, \u0447\u0435\u0441\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806849
    m_Localized: "\u041B\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806850
    m_Localized: "\u043A\u0443\u0440\u044C\u0435\u0440, \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806851
    m_Localized: "\u0423 \u043C\u0435\u043D\u044F \u0432\u043E\u0441\u0435\u043C\u044C \u043F\u043E\u0441\u044B\u043B\u043E\u043A \u0438 \u043F\u043E\u043B\u0447\u0430\u0441\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806852
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u043E\u0447\u0435\u0440\u0435\u0434\u044C, \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806853
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u041C\u0430\u0439\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806854
    m_Localized: "\u043D\u043E\u0447\u043D\u043E\u0439 \u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806855
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u043D\u0430 \u0442\u0440\u0430\u0441\u0441\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u044F \u0434\u0430 \u043A\u043E\u0439\u043E\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806856
    m_Localized: "\u0414\u0438\u0437\u0435\u043B\u044C, \u043F\u043E\u043D\u0447\u0438\u043A \u0438 \u0434\u0435\u0441\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442 \u0442\u0438\u0448\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806857
    m_Localized: "\u0414\u043E\u043A\u0442\u043E\u0440 \u041A\u0430\u0440\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806858
    m_Localized: "\u0432\u0440\u0430\u0447, \u043F\u043E \u0443\u0442\u0440\u0430\u043C \u0435\u0434\u0435\u0442 \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806859
    m_Localized: "\u0421\u043C\u0435\u043D\u0430 \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0440\u043E\u043A \u043C\u0438\u043D\u0443\u0442, \u0432\u044B\u0440\u0443\u0447\u0430\u0439\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806860
    m_Localized: "\u0427\u0438\u0441\u0442\u044B\u0439 \u0442\u0443\u0430\u043B\u0435\u0442 \u043D\u0430 \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0435 \u2014 \u044D\u0442\u043E \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806861
    m_Localized: "\u0428\u0435\u0440\u0438\u0444 \u0414\u043E\u0443\u0441\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806862
    m_Localized: "\u0441\u043B\u0435\u0434\u0438\u0442 \u0437\u0430 \u043F\u043E\u0440\u044F\u0434\u043A\u043E\u043C \u043D\u0430 \u0442\u0440\u0430\u0441\u0441\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806863
    m_Localized: "\u0412\u0441\u0451 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E? \u0412\u043E\u0440\u043E\u0432 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806864
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0430 \u2014 \u043C\u0435\u043D\u044C\u0448\u0435 \u0440\u0430\u0431\u043E\u0442\u044B \u043F\u043E\u043B\u0438\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806865
    m_Localized: "\u0424\u0435\u0440\u043C\u0435\u0440 \u0420\u043E\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806866
    m_Localized: "\u0432\u0435\u0437\u0451\u0442 \u0443\u0440\u043E\u0436\u0430\u0439 \u043D\u0430 \u0440\u044B\u043D\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806867
    m_Localized: "\u041F\u0438\u043A\u0430\u043F \u043F\u043E\u043B\u043D\u044B\u0439 \u0430\u0440\u0431\u0443\u0437\u043E\u0432, \u0430 \u0431\u0430\u043A \u043F\u0443\u0441\u0442\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806868
    m_Localized: "\u0417\u0430\u0441\u0443\u0445\u0430 \u0432 \u044D\u0442\u043E\u043C \u0433\u043E\u0434\u0443, \u043D\u043E \u043C\u044B \u0434\u0435\u0440\u0436\u0438\u043C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806869
    m_Localized: "\u041A\u043E\u043C\u043C\u0438\u0432\u043E\u044F\u0436\u0451\u0440 \u0422\u043E\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806870
    m_Localized: "\u043F\u0440\u043E\u0434\u0430\u0451\u0442 \u043F\u044B\u043B\u0435\u0441\u043E\u0441\u044B \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u0448\u0442\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806871
    m_Localized: "\u041A\u0441\u0442\u0430\u0442\u0438, \u043F\u044B\u043B\u0435\u0441\u043E\u0441 \u0432\u0430\u043C \u043D\u0435 \u043D\u0443\u0436\u0435\u043D? \u0428\u0443\u0447\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806872
    m_Localized: "\u0415\u0449\u0451 \u0442\u0440\u0438 \u0433\u043E\u0440\u043E\u0434\u0430 \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430. \u041A\u043E\u0444\u0435, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806873
    m_Localized: "\u0421\u0435\u043C\u044C\u044F \u041A\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806874
    m_Localized: "\u0432\u043E\u0441\u043A\u0440\u0435\u0441\u043D\u044B\u0435 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806875
    m_Localized: "\u041A\u0430\u043A\u0438\u0435 \u0441\u0443\u0432\u0435\u043D\u0438\u0440\u044B \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806876
    m_Localized: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0435\u043C\u0441\u044F \u0443 \u0432\u0430\u0448\u0435\u0439 \u0432\u044B\u0432\u0435\u0441\u043A\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806877
    m_Localized: "\u0421\u0442\u0443\u0434\u0435\u043D\u0442 \u0414\u0436\u0435\u0439\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806878
    m_Localized: "\u0435\u0434\u0435\u0442 \u0434\u043E\u043C\u043E\u0439 \u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806879
    m_Localized: "\u041D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432, \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442..."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806880
    m_Localized: "\u0427\u0438\u043F\u0441\u044B \u0438 \u0433\u0430\u0437\u0438\u0440\u043E\u0432\u043A\u0430 \u2014 \u0443\u0436\u0438\u043D \u0447\u0435\u043C\u043F\u0438\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806881
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u041E\u043B\u044C\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806882
    m_Localized: "\u0435\u0434\u0435\u0442 \u043A \u0432\u043D\u0443\u043A\u0430\u043C \u043F\u043E \u0441\u0440\u0435\u0434\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806883
    m_Localized: "\u0412\u043D\u0443\u043A\u0430\u043C \u043A\u043E\u043D\u0444\u0435\u0442 \u0432\u043E\u0437\u044C\u043C\u0443, \u0443 \u0432\u0430\u0441 \u0441\u0432\u0435\u0436\u0438\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806884
    m_Localized: "\u041A\u0430\u043A\u043E\u0439 \u0432\u0435\u0436\u043B\u0438\u0432\u044B\u0439 \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806885
    m_Localized: "\u041C\u0435\u0445\u0430\u043D\u0438\u043A \u0421\u044D\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806886
    m_Localized: "\u0447\u0438\u043D\u0438\u0442 \u0432\u0441\u0451, \u0447\u0442\u043E \u0435\u0437\u0434\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806887
    m_Localized: "\u041A\u043E\u043B\u043E\u043D\u043A\u0443 \u043D\u0435 \u043F\u043E\u0440\u0430 \u0441\u043C\u0430\u0437\u0430\u0442\u044C? \u0421\u043B\u044B\u0448\u0443 \u2014 \u0441\u043A\u0440\u0438\u043F\u0438\u0442."
    m_Metadata:
      m_Items: []
