    m_Localized: "\u0412\u043E\u0440 \u0443\u0435\u0445\u0430\u043B \u0431\u0435\u0437 \u043E\u043F\u043B\u0430\u0442\u044B! \u041F\u043E\u0442\u0435\u0440\u044F\u043D\u043E ${0:0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806562
    m_Localized: "\u0412\u043E\u0440 \u043F\u043E\u0439\u043C\u0430\u043D \u0438 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806563
    m_Localized: "\u0426\u0435\u043D\u044B \u043D\u0430 \u043D\u0435\u0444\u0442\u044C: {0:+0.0;-0.0;0}%. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0441\u0432\u043E\u0438 \u0446\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806564
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0438 \u0432\u0430\u043D\u0434\u0430\u043B\u044B \u0438 \u043D\u0430\u043C\u0443\u0441\u043E\u0440\u0438\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806565
    m_Localized: "\u0427\u0430\u0441 \u043F\u0438\u043A: \u0442\u0443\u0440\u0438\u0441\u0442\u044B \u0435\u0434\u0443\u0442 \u0442\u043E\u043B\u043F\u043E\u0439!"
    m_Metadata:
      m_Items: []
