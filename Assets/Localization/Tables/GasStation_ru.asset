    m_Localized: "\u041A\u043E\u043B\u043E\u043D\u043A\u0430 {0:0} \u0441\u043B\u043E\u043C\u0430\u043B\u0430\u0441\u044C! \u041F\u043E\u0447\u0438\u043D\u0438\u0442\u0435 \u0435\u0451 (E)"
    m_Metadata:
      m_Items: []
