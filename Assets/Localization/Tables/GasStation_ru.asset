    m_Localized: "\u0413\u043B\u0430\u0432\u0430 {0}: \u0432\u044B\u043F\u043B\u0430\u0447\u0435\u043D\u043E ${1:0} \u0438\u0437 ${2:0} \u0434\u043E \u0434\u043D\u044F {3}"
