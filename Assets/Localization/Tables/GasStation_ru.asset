      m_Items: []
  - m_Id: 1231806661
    m_Localized: "\u0422\u044B \u043A\u0443\u043F\u0438\u043B \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u0443\u044E \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0443 \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u043F\u0443\u0441\u0442\u044B\u043D\u0438. \u041A\u043E\u043B\u043E\u043D\u043A\u0438 \u0441\u043B\u043E\u043C\u0430\u043D\u044B, \u043E\u043A\u043D\u0430 \u0437\u0430\u043A\u043E\u043B\u043E\u0447\u0435\u043D\u044B, \u043F\u043E\u0432\u0441\u044E\u0434\u0443 \u043C\u0443\u0441\u043E\u0440, \u0430 \u0434\u0435\u043D\u0435\u0433 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u0442.\n\n\u0417\u0430\u0434\u0430\u0447\u0430 \u2014 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0436\u0438\u0437\u043D\u044C: \u043D\u0430\u0432\u0435\u0441\u0442\u0438 \u043F\u043E\u0440\u044F\u0434\u043E\u043A, \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0442\u044C \u043F\u0440\u043E\u0435\u0437\u0436\u0430\u044E\u0449\u0438\u0445 \u0438 \u0432\u043B\u043E\u0436\u0438\u0442\u044C \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0435 \u0432 \u0440\u0435\u043C\u043E\u043D\u0442 \u0438 \u043D\u043E\u0432\u044B\u0435 \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806662
    m_Localized: "\u041A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806663
    m_Localized: "\u0425\u043E\u0434\u0438 \u043D\u0430 WASD. E (\u0438\u043B\u0438 \u041B\u041A\u041C) \u2014 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0440\u044F\u0434\u043E\u043C: \u0437\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0436\u0434\u0443\u0449\u0443\u044E \u043C\u0430\u0448\u0438\u043D\u0443, \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u043A\u043E\u043B\u043E\u043D\u043A\u0443, \u043E\u0442\u0440\u0435\u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0435, \u0443\u0431\u0440\u0430\u0442\u044C \u0442\u0443\u0430\u043B\u0435\u0442, \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u043C\u0443\u0441\u043E\u0440.\n\n\u041C\u0430\u0448\u0438\u043D\u044B \u0441\u0430\u043C\u0438 \u0432\u0441\u0442\u0430\u044E\u0442 \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u044C. \u041F\u043E\u0434\u043E\u0439\u0434\u0438 \u043A \u043A\u043E\u043B\u043E\u043D\u043A\u0435, \u0433\u0434\u0435 \u043C\u0430\u0448\u0438\u043D\u0430 \u0436\u0434\u0451\u0442, \u0438 \u043D\u0430\u0436\u043C\u0438 E. \u041A\u043B\u0438\u0435\u043D\u0442 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442 \u0438 \u0443\u0435\u0434\u0435\u0442 \u2014 \u0438\u043B\u0438 \u0437\u0430\u0439\u0434\u0451\u0442 \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806664
    m_Localized: "\u0414\u0435\u043D\u044C\u0433\u0438 \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806665
    m_Localized: "\u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u0437\u0430\u043F\u0430\u0441\u0430\u043C\u0438 \u0442\u043E\u043F\u043B\u0438\u0432\u0430 (\u0441\u043F\u0440\u0430\u0432\u0430 \u0441\u0432\u0435\u0440\u0445\u0443) \u0438 \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0439 \u0431\u0435\u043D\u0437\u043E\u0432\u043E\u0437 \u043A\u043B\u0430\u0432\u0438\u0448\u0435\u0439 O \u2014 \u043E\u043D \u043F\u0440\u0438\u0435\u0434\u0435\u0442 \u0438 \u0441\u043E\u043B\u044C\u0451\u0442 \u0442\u043E\u043F\u043B\u0438\u0432\u043E. \u0426\u0435\u043D\u044B \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u043A\u043B\u0430\u0432\u0438\u0448\u0430\u043C\u0438 +/\u2212.\n\nTab \u2014 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F, M \u2014 \u0442\u043E\u0432\u0430\u0440\u044B \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430, H \u2014 \u043D\u0430\u0439\u043C \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430, C \u2014 \u043F\u043E\u043A\u0440\u0430\u0441\u043A\u0430. \u041D\u043E\u0432\u044B\u0435 \u0437\u0434\u0430\u043D\u0438\u044F \u0441\u0442\u0440\u043E\u044F\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806666
    m_Localized: "\u0417\u0430\u0434\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806667
    m_Localized: "\u0412\u0432\u0435\u0440\u0445\u0443 \u044D\u043A\u0440\u0430\u043D\u0430 \u2014 \u0442\u0435\u043A\u0443\u0449\u0435\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435, \u0430 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u0430\u044F \u0441\u0442\u0440\u0435\u043B\u043A\u0430 \u25BC \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u043A\u0443\u0434\u0430 \u0438\u0434\u0442\u0438. \u0417\u0430\u0434\u0430\u043D\u0438\u044F \u0432\u0435\u0434\u0443\u0442 \u043E\u0442 \u0443\u0431\u043E\u0440\u043A\u0438 \u043C\u0443\u0441\u043E\u0440\u0430 \u043A \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C\u0443 \u043C\u043E\u0442\u0435\u043B\u044E.\n\nEsc \u2014 \u043F\u0430\u0443\u0437\u0430 \u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438, T \u2014 \u0443\u0441\u043A\u043E\u0440\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F, J \u2014 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806668
    m_Localized: "\u041D\u043E\u0443\u0442\u0431\u0443\u043A \u0438 \u0441\u0442\u0440\u043E\u0439\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806669
    m_Localized: "\u041D\u0430 \u0441\u0442\u043E\u043B\u0435 \u0443 \u0434\u0432\u0435\u0440\u0438 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u0441\u0442\u043E\u0438\u0442 \u043D\u043E\u0443\u0442\u0431\u0443\u043A (E \u0440\u044F\u0434\u043E\u043C \u0438\u043B\u0438 N \u043E\u0442\u043A\u0443\u0434\u0430 \u0443\u0433\u043E\u0434\u043D\u043E). \u0422\u0430\u043C \u043F\u043E\u0447\u0442\u0430 \u0441 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430\u043C\u0438, \u0431\u0430\u043D\u043A, \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B, \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u0438, \u043D\u0430\u0432\u044B\u043A\u0438 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430, \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u044F \u0438 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044F \u2014 \u0432\u0441\u0451 \u043C\u044B\u0448\u044C\u044E.\n\nB \u2014 \u0440\u0435\u0436\u0438\u043C \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430: \u0443\u0440\u043D\u044B, \u0441\u043A\u0430\u043C\u0435\u0439\u043A\u0438, \u0444\u043E\u043D\u0430\u0440\u0438, \u043A\u0430\u043C\u0435\u0440\u044B \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B, \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u0432\u043E\u044F \u043F\u043E\u043B\u044C\u0437\u0430.\n\nK \u2014 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u043A\u043B\u0438\u0435\u043D\u0442\u044B, F \u2014 \u0444\u0438\u043D\u0430\u043D\u0441\u044B, F12 \u2014 \u0444\u043E\u0442\u043E\u0440\u0435\u0436\u0438\u043C. \u0423\u0434\u0430\u0447\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806670
    m_Localized: "\u041B\u0443\u0447\u0448\u0430\u044F \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0430 \u043D\u0430 \u0442\u0440\u0430\u0441\u0441\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806671
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u043E, \u0447\u0438\u0441\u0442\u043E, \u0432\u0435\u0436\u043B\u0438\u0432\u043E. \u0412\u0435\u0440\u043D\u0443\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806672
    m_Localized: "\u041F\u044F\u0442\u044C \u0437\u0432\u0451\u0437\u0434, \u043A\u043E\u0444\u0435 \u0442\u043E\u0436\u0435 \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806673
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0435\u0435 \u043C\u0435\u0441\u0442\u043E, \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0437 \u043E\u0447\u0435\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806674
    m_Localized: "\u0412\u0441\u0451 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E, \u0446\u0435\u043D\u044B \u0442\u0435\u0440\u043F\u0438\u043C\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806675
    m_Localized: "\u041F\u0440\u0438\u044F\u0442\u043D\u0430\u044F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0432 \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806676
    m_Localized: "\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E, \u043D\u043E \u043C\u043E\u0436\u043D\u043E \u043B\u0443\u0447\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806677
    m_Localized: "\u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806678
    m_Localized: "\u0426\u0435\u043D\u044B \u043A\u0443\u0441\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806679
    m_Localized: "\u0414\u043E\u043B\u0433\u043E \u0438 \u0433\u0440\u044F\u0437\u043D\u043E\u0432\u0430\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806680
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u043E \u0434\u043B\u044F \u0442\u0430\u043A\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806681
    m_Localized: "\u041D\u0435 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0438\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806682
    m_Localized: "\u0416\u0434\u0430\u043B \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C \u0438 \u0443\u0435\u0445\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806683
    m_Localized: "\u0423\u0436\u0430\u0441\u043D\u043E\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806684
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0435 \u0441\u044E\u0434\u0430 \u043D\u0438 \u043D\u043E\u0433\u043E\u0439."
