    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u0430! \u041F\u0440\u0435\u043C\u0438\u044F ${0:0}"
