  - m_Id: 1231806798
    m_Localized: "\u0412\u044B\u043A\u0443\u043F\u0438\u0442\u044C PetroMax \u0437\u0430 ${0:0}? \u041D\u0430\u0436\u043C\u0438 1 \u0435\u0449\u0451 \u0440\u0430\u0437"
