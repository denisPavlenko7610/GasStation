    m_Metadata:
      m_Items: []
  - m_Id: 1240195306
    m_Localized: "\u041D\u043E\u0432\u044B\u0445 \u043F\u0438\u0441\u0435\u043C \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1240195307
    m_Localized: "\u0421\u0442\u0430\u043D\u0446\u0438\u044F \u0443\u0448\u043B\u0430 \u0431\u0430\u043D\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195308
    m_Localized: "\xAB{0}\xBB \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0430 \u0432\u044B\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0434\u043E\u043B\u0433 \u0434\u044F\u0434\u0438: \u043D\u0430 {1}-\u0439 \u0434\u0435\u043D\u044C \u0431\u0430\u043D\u043A \u0437\u0430\u0431\u0440\u0430\u043B \u0441\u0442\u0430\u043D\u0446\u0438\u044E.\n\u041E\u0431\u0441\u043B\u0443\u0436\u0435\u043D\u043E \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432: {2}. \u0423\u0440\u043E\u0432\u0435\u043D\u044C \u0441\u0442\u0430\u043D\u0446\u0438\u0438: {3}."
    m_Metadata:
      m_Items: []
  - m_Id: 1240195309
    m_Localized: "\u041A\u043E\u043D\u0435\u0446 \u0438\u0441\u0442\u043E\u0440\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195310
    m_Localized: "\xAB{0}\xBB \u043F\u0440\u043E\u0434\u0430\u043D\u0430 \u0441\u0435\u0442\u0438 PetroMax \u043D\u0430 {1}-\u0439 \u0434\u0435\u043D\u044C. \u0414\u0435\u043D\u044C\u0433\u0438 \u0435\u0441\u0442\u044C, \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u043D\u0435\u0442.\n\u041E\u0431\u0441\u043B\u0443\u0436\u0435\u043D\u043E \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432: {2}. \u0423\u0440\u043E\u0432\u0435\u043D\u044C \u0441\u0442\u0430\u043D\u0446\u0438\u0438: {3}."
    m_Metadata:
      m_Items: []
  - m_Id: 1240195311
    m_Localized: "\u041D\u0430\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u043E \u0441\u043F\u0430\u0441\u0435\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195312
    m_Localized: "\xAB{0}\xBB \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u043B\u0430\u0441\u044C \u0441 \u0431\u0430\u043D\u043A\u043E\u043C \u043D\u0430 {1}-\u0439 \u0434\u0435\u043D\u044C.\n\u041E\u0431\u0441\u043B\u0443\u0436\u0435\u043D\u043E \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432: {2}. \u0417\u0432\u0451\u0437\u0434 \u0443 \u0441\u0442\u0430\u043D\u0446\u0438\u0438: {3}.\n\u0414\u044F\u0434\u044F \u0431\u044B \u0433\u043E\u0440\u0434\u0438\u043B\u0441\u044F. \u0421\u0442\u0430\u043D\u0446\u0438\u044F \u0442\u0432\u043E\u044F \u2014 \u0438\u0433\u0440\u0430\u0439 \u0434\u0430\u043B\u044C\u0448\u0435 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
