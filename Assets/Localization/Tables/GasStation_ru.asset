    m_Localized: "\u0412\u043D\u0435\u0441\u0442\u0438 \u0432\u0441\u0451 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0435 (${0:0})"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195289
    m_Localized: "\u0413\u043B\u0430\u0432\u0430 1. \u041F\u0438\u0441\u044C\u043C\u043E \u043E\u0442 \u043D\u043E\u0442\u0430\u0440\u0438\u0443\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195290
    m_Localized: "\xAB\u0412\u0430\u0448 \u0434\u044F\u0434\u044F \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0432\u0430\u043C \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0443 \u0443 \u0442\u0440\u0430\u0441\u0441\u044B \u2014 \u0438 \u0434\u043E\u043B\u0433 \u0431\u0430\u043D\u043A\u0443 \u043D\u0430 $50 000. \u0411\u0430\u043D\u043A \u0436\u0434\u0451\u0442 \u043F\u0435\u0440\u0432\u044B\u0435 $5 000 \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0441\u044F\u0442\u044C \u0434\u043D\u0435\u0439, \u0438 \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u0434\u043E\u043B\u0436\u043D\u0430 \u0441\u043D\u043E\u0432\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C (\u0443\u0440\u043E\u0432\u0435\u043D\u044C 3). \u0423\u0434\u0430\u0447\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195291
    m_Localized: "\u0413\u043B\u0430\u0432\u0430 2. \u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 PetroMax"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195292
    m_Localized: "\xAB\u0411\u0430\u043D\u043A \u0434\u043E\u0432\u043E\u043B\u0435\u043D \u043F\u0435\u0440\u0432\u044B\u043C \u0432\u0437\u043D\u043E\u0441\u043E\u043C. \u041A \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u043E\u043C\u0443 \u0434\u043D\u044E \u0432\u044B\u043F\u043B\u0430\u0442\u0438\u0442\u0435 $20 000 \u0432 \u0441\u0443\u043C\u043C\u0435. P. S. \u0421\u0435\u0442\u044C PetroMax \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442\u0441\u044F \u0432\u0430\u0448\u0435\u0439 \u0437\u0435\u043C\u043B\u0451\u0439.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195293
    m_Localized: "\u0413\u043B\u0430\u0432\u0430 3. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0441\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195294
    m_Localized: "\xAB\u041E\u0441\u0442\u0430\u0442\u043E\u043A \u0434\u043E\u043B\u0433\u0430 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0433\u0430\u0441\u0438\u0442\u044C \u043A \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u043E\u043C\u0443 \u0434\u043D\u044E. \u0418\u043D\u0430\u0447\u0435 \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u043F\u0435\u0440\u0435\u0439\u0434\u0451\u0442 \u0431\u0430\u043D\u043A\u0443.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195295
    m_Localized: "PetroMax: \u043A\u0443\u043F\u0438\u043C \u0432\u0430\u0448\u0443 \u0437\u0435\u043C\u043B\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195296
    m_Localized: "\xAB\u041F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u043C ${0:0} \u0437\u0430 \u0443\u0447\u0430\u0441\u0442\u043E\u043A. \u0414\u043E\u043B\u0433\u0438 \u2014 \u043D\u0435 \u0432\u0430\u0448\u0430 \u0437\u0430\u0431\u043E\u0442\u0430. \u041F\u043E\u0434\u043F\u0438\u0448\u0438\u0442\u0435, \u0438 \u0434\u0435\u043B\u043E \u0441 \u043A\u043E\u043D\u0446\u043E\u043C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195297
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0437\u0430 ${0:0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195298
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195299
    m_Localized: "\u0414\u043E\u043B\u0433 \u0432\u044B\u043F\u043B\u0430\u0447\u0435\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 1240195300
    m_Localized: "\u0421\u0442\u0430\u043D\u0446\u0438\u044F \u0442\u0432\u043E\u044F. \u0414\u044F\u0434\u044F \u0431\u044B \u0433\u043E\u0440\u0434\u0438\u043B\u0441\u044F. \u0414\u0430\u043B\u044C\u0448\u0435 \u2014 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430\u044F \u0438\u0433\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1240195301
    m_Localized: "\u0411\u0430\u043D\u043A \u0437\u0430\u0431\u0440\u0430\u043B \u0441\u0442\u0430\u043D\u0446\u0438\u044E"
