    m_Localized: "\u0420\u044B\u043D\u043E\u0447\u043D\u0430\u044F \u0446\u0435\u043D\u0430 \u043F\u043E\u043B\u0437\u0451\u0442 \u0432\u0432\u0435\u0440\u0445 \u043D\u0430 25%, \u043A\u043B\u0438\u0435\u043D\u0442\u044B \u0437\u0430\u043B\u0438\u0432\u0430\u044E\u0442 \u043D\u0430 30% \u043C\u0435\u043D\u044C\u0448\u0435."
