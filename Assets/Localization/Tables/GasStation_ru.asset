  - m_Id: 1231806751
    m_Localized: "\u0410\u0432\u0442\u043E\u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0432 \u043A\u043E\u043D\u0446\u0435 \u0434\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806752
    m_Localized: "WASD / \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u2014 \u0445\u043E\u0434\u0438\u0442\u044C, \u043C\u044B\u0448\u044C \u2014 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043F\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C\nE / \u041B\u041A\u041C \u2014 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441 \u0442\u0435\u043C, \u043D\u0430 \u0447\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C: \u0437\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043C\u0430\u0448\u0438\u043D\u0443, \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C \u0448\u0438\u043D\u044B, \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u043A\u043E\u043B\u043E\u043D\u043A\u0443, \u0443\u0431\u0440\u0430\u0442\u044C \u0442\u0443\u0430\u043B\u0435\u0442 \u0438\u043B\u0438 \u043D\u043E\u043C\u0435\u0440 \u043C\u043E\u0442\u0435\u043B\u044F, \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u043C\u0443\u0441\u043E\u0440\n\n1 / 2 / 3 \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0442\u043E\u043F\u043B\u0438\u0432\u043E   + / \u2212 \u2014 \u0446\u0435\u043D\u0430   O \u2014 \u0437\u0430\u043A\u0430\u0437\u0430\u0442\u044C 500 \u043B\nTab \u2014 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F (\u043B\u0438\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043F\u043E \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430\u043C)   M \u2014 \u043C\u0430\u0433\u0430\u0437\u0438\u043D   C \u2014 \u043F\u043E\u043A\u0440\u0430\u0441\u043A\u0430   H \u2014 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B   J \u2014 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F   K \u2014 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u043A\u043B\u0438\u0435\u043D\u0442\u044B   F \u2014 \u0444\u0438\u043D\u0430\u043D\u0441\u044B, \u0431\u0430\u043D\u043A, \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\n\u041D\u043E\u0443\u0442\u0431\u0443\u043A \u0443 \u0434\u0432\u0435\u0440\u0438 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 (E \u0440\u044F\u0434\u043E\u043C \u0438\u043B\u0438 N \u043E\u0442\u043A\u0443\u0434\u0430 \u0443\u0433\u043E\u0434\u043D\u043E): \u043F\u043E\u0447\u0442\u0430 \u0441 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430\u043C\u0438, \u0431\u0430\u043D\u043A, \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442, \u043A\u043B\u0438\u0435\u043D\u0442\u044B, \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430 \u2014 \u0432\u0441\u0451 \u043C\u044B\u0448\u044C\u044E\nB \u2014 \u0440\u0435\u0436\u0438\u043C \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430: WASD \u2014 \u043A\u0430\u043C\u0435\u0440\u0430, \u043A\u043E\u043B\u0435\u0441\u043E \u2014 \u043C\u0430\u0441\u0448\u0442\u0430\u0431, 1\u20138 \u2014 \u043E\u0431\u044A\u0435\u043A\u0442, Q / E \u2014 \u043F\u043E\u0432\u043E\u0440\u043E\u0442, \u041B\u041A\u041C \u2014 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C, \u041F\u041A\u041C \u2014 \u0443\u0431\u0440\u0430\u0442\u044C\nF12 \u2014 \u0444\u043E\u0442\u043E\u0440\u0435\u0436\u0438\u043C: \u043A\u0430\u043C\u0435\u0440\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430, \u043F\u0440\u043E\u0431\u0435\u043B \u2014 \u0441\u043D\u0438\u043C\u043E\u043A\n\nT \u2014 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0438\u0433\u0440\u044B \xD71 / \xD72 / \xD73   R \u2014 \u0440\u0430\u0434\u0438\u043E   F1 \u2014 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438   L \u2014 \u044F\u0437\u044B\u043A\nF5 \u2014 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C   F9 \u2014 \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C   Esc \u2014 \u043F\u0430\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806753
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0433\u0430\u0441\u0438 \u0442\u0435\u043A\u0443\u0449\u0438\u0439 \u043A\u0440\u0435\u0434\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806754
    m_Localized: "\u041A\u0440\u0435\u0434\u0438\u0442 ${0:0} \u043F\u043E\u043B\u0443\u0447\u0435\u043D. \u041F\u043B\u0430\u0442\u0451\u0436 ${1:0} \u0432 \u043D\u0435\u0434\u0435\u043B\u044E, {2} \u043D\u0435\u0434\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
