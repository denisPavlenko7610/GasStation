      m_Items: []
  - m_Id: 1231806809
    m_Localized: "\u041A\u0430\u043C\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806810
    m_Localized: "\u041A\u043B\u0438\u0435\u043D\u0442\u044B \u0440\u044F\u0434\u043E\u043C (6 \u043C) \u043C\u0443\u0441\u043E\u0440\u044F\u0442 \u043D\u0430 70% \u043C\u0435\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806811
    m_Localized: "\u0416\u0434\u0430\u0442\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u0435\u0435: +4% \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044F \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 (\u0434\u043E 5 \u0441\u043A\u0430\u043C\u0435\u0435\u043A)."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806812
    m_Localized: "\u0421\u0442\u0430\u043D\u0446\u0438\u044F \u043A\u0440\u0430\u0441\u0438\u0432\u0435\u0435: +2% \u0442\u0440\u0430\u0444\u0438\u043A\u0430 (\u0434\u043E 10 \u043A\u043B\u0443\u043C\u0431)."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806813
    m_Localized: "\u0421\u0432\u0435\u0442\u0438\u0442 \u043D\u043E\u0447\u044C\u044E, \u043E\u0442\u043F\u0443\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u043D\u0434\u0430\u043B\u043E\u0432 \u0438 \u0432\u043E\u0440\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1231806814
    m_Localized: "\u0412\u043E\u0434\u0438\u0442\u0435\u043B\u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u044E\u0442 \u0441\u0442\u0430\u043D\u0446\u0438\u044E: +6% \u0442\u0440\u0430\u0444\u0438\u043A\u0430 (\u0434\u043E 3 \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u0439)."
    m_Metadata:
