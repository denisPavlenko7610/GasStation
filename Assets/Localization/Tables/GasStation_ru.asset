    m_Localized: "\u041A\u043B\u0438\u0435\u043D\u0442 \u0432 \u0443\u0436\u0430\u0441\u0435 \u043E\u0442 \u0442\u0443\u0430\u043B\u0435\u0442\u0430! \u0423\u0431\u0435\u0440\u0438\u0442\u0435 \u0435\u0433\u043E (E \u0443 \u0434\u0432\u0435\u0440\u0438)"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806571
    m_Localized: "\u0418\u0437 \u043A\u0430\u0441\u0441\u044B \u043F\u0440\u043E\u043F\u0430\u043B\u043E ${0:0}. \u041A\u0442\u043E-\u0442\u043E \u0438\u0437 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432 \u043D\u0435\u0447\u0438\u0441\u0442 \u043D\u0430 \u0440\u0443\u043A\u0443\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806572
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u0449\u0438\u043A \u0432\u0441\u0442\u0430\u043B \u043D\u0430 \u043D\u043E\u0447\u0451\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806573
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u0449\u0438\u043A \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u0437\u0430 \u043D\u043E\u0447\u044C: ${0:0}"
    m_Metadata:
      m_Items: []
