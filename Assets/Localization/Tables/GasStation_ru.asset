    m_Metadata:
      m_Items: []
  - m_Id: 1227612177
    m_Localized: "\u0421\u0442\u043E\u044F\u043D\u043A\u0430 \u0434\u043B\u044F \u0444\u0443\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612178
    m_Localized: "\u0428\u0438\u043D\u043E\u043C\u043E\u043D\u0442\u0430\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612179
    m_Localized: "\u041C\u043E\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612180
    m_Localized: "+50% \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612181
    m_Localized: "+1000 \u043B \u043A \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u0440\u0435\u0437\u0435\u0440\u0432\u0443\u0430\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612182
    m_Localized: "\u043A\u043B\u0438\u0435\u043D\u0442\u044B \u0436\u0434\u0443\u0442 \u043D\u0430 20% \u0434\u043E\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612183
    m_Localized: "+25% \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612184
    m_Localized: "\u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0435\u0449\u0451 \u043E\u0434\u043D\u0443 \u043A\u043E\u043B\u043E\u043D\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612185
    m_Localized: "\u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043C\u043E\u0439\u043A\u0443, \u0443\u0440\u043E\u0432\u043D\u0438 \u2014 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0438 \u0434\u043E\u0440\u043E\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612186
    m_Localized: "\u0441\u0430\u043C \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0442\u043E\u043F\u043B\u0438\u0432\u043E \u0438 \u0442\u043E\u0432\u0430\u0440; \u0443\u0440.2 \u221210%, \u0443\u0440.3 \u0431\u044B\u0441\u0442\u0440\u0435\u0435; $50/\u0434\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612187
    m_Localized: "+2 \u043C\u0435\u0441\u0442\u0430 \u0434\u043B\u044F \u043D\u043E\u0447\u0451\u0432\u043A\u0438 \u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u0449\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612188
    m_Localized: "\u043C\u0435\u043D\u044F\u0435\u0442\u0435 \u0448\u0438\u043D\u044B \u0437\u0430 \u0434\u0435\u043D\u044C\u0433\u0438; \u0443\u0440\u043E\u0432\u043D\u0438 \u2014 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0438 \u0434\u043E\u0440\u043E\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612189
    m_Localized: "+2 \u043D\u043E\u043C\u0435\u0440\u0430 \u0434\u043B\u044F \u043D\u043E\u0447\u0451\u0432\u043A\u0438 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u043E\u0432, \u043D\u043E\u043C\u0435\u0440\u0430 \u0434\u043E\u0440\u043E\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1227612190
    m_Localized: "\u0437\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A"
