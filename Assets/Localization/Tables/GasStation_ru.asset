    m_Localized: "\u0412\u043D\u0435\u0441\u0435\u043D\u043E ${0:0} \u0432 \u0441\u0447\u0451\u0442 \u0434\u043E\u043B\u0433\u0430 \u0434\u044F\u0434\u0438. \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C ${1:0}"
