    m_Localized: "\u041A\u043B\u0438\u0435\u043D\u0442\u044B \u043F\u043E\u0434\u043A\u0430\u0447\u0438\u0432\u0430\u044E\u0442 \u0448\u0438\u043D\u044B: \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0434\u0435\u043D\u0435\u0433 \u0438 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438."
