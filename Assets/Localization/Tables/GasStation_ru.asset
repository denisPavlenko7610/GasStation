    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430: \u0433\u0440\u044F\u0437\u043D\u043E! \u0428\u0442\u0440\u0430\u0444 ${0:0}"
    m_Metadata:
      m_Items: []
