  - m_Id: 1231806688
    m_Localized: "\u0424\u0418\u041D\u0410\u041D\u0421\u042B (F \u2014 \u0431\u0430\u043D\u043A)"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806689
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F: +${0:0} / -${1:0} = ${2:0}"
    m_Metadata:
