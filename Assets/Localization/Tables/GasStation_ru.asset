    m_Localized: "\u041F\u0435\u0441\u0447\u0430\u043D\u0430\u044F \u0431\u0443\u0440\u044F: \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u043C\u0430\u043B\u043E, \u043C\u0443\u0441\u043E\u0440\u0430 \u043C\u043D\u043E\u0433\u043E"
