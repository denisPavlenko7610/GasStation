    m_Localized: "\u041A\u043E\u043B\u043E\u043D\u043A\u0430 {0:0} \u043A\u0430\u043A \u043D\u043E\u0432\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806558
    m_Localized: "\u041D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0434\u0435\u043D\u0435\u0433: \u043D\u0443\u0436\u043D\u043E ${0:0}"
    m_Metadata:
      m_Items: []
