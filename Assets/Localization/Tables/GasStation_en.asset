  - m_Id: 1231806773
    m_Localized: Half bills, no bankruptcy.
    m_Metadata:
      m_Items: []
  - m_Id: 1231806774
    m_Localized: Normal bills. 7 days in the red means bankruptcy.
    m_Metadata:
      m_Items: []
  - m_Id: 1231806775
    m_Localized: Bills are 50% higher. 4 days in the red and the game is over.
    m_Metadata:
      m_Items: []
