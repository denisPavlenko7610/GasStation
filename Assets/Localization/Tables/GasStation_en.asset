    m_Metadata:
      m_Items: []
  - m_Id: 1231806767
    m_Localized: "PetroMax is running a sale: \u221210% on fuel"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806768
    m_Localized: PetroMax launched a highway ad campaign
    m_Metadata:
      m_Items: []
  - m_Id: 1231806769
    m_Localized: PetroMax is yours now! Every driver on the road comes to you
    m_Metadata:
      m_Items: []
  - m_Id: 1231806770
    m_Localized: Relaxed
    m_Metadata:
      m_Items: []
  - m_Id: 1231806771
