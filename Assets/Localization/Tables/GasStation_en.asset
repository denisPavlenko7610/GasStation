    m_Localized: "BANK \u2014 difficulty: {0} (F \u2014 competitor)"
    m_Metadata:
      m_Items: []
  - m_Id: 1231806777
    m_Localized: 'No loan. The bank offers:'
    m_Metadata:
      m_Items: []
  - m_Id: 1231806778
    m_Localized: "{0}. ${1:0} at {2:0}% for {3} weeks \u2014 ${4:0} a week"
