  - m_Id: 1231806805
    m_Localized: Lamp
    m_Metadata:
      m_Items: []
  - m_Id: 1231806806
    m_Localized: Road sign
    m_Metadata:
      m_Items: []
  - m_Id: 1231806807
    m_Localized: Air pump
    m_Metadata:
      m_Items: []
  - m_Id: 1231806808
    m_Localized: Water machine
    m_Metadata:
      m_Items: []
  - m_Id: 1231806809
    m_Localized: Security camera
    m_Metadata:
      m_Items: []
  - m_Id: 1231806810
    m_Localized: Customers nearby (6 m) litter 70% less.
    m_Metadata:
      m_Items: []
  - m_Id: 1231806811
    m_Localized: 'Waiting is easier: +4% customer patience (up to 5 benches).'
    m_Metadata:
      m_Items: []
  - m_Id: 1231806812
    m_Localized: 'A nicer station: +2% traffic (up to 10 planters).'
    m_Metadata:
      m_Items: []
  - m_Id: 1231806813
    m_Localized: Lights up the night, scares off vandals and thieves.
    m_Metadata:
      m_Items: []
  - m_Id: 1231806814
    m_Localized: 'Drivers notice the station: +6% traffic (up to 3 signs).'
    m_Metadata:
      m_Items: []
  - m_Id: 1231806815
    m_Localized: 'Customers pump up their tires: a little money and reputation.'
    m_Metadata:
      m_Items: []
  - m_Id: 1231806816
    m_Localized: 'Customers buy water: $3 every now and then.'
    m_Metadata:
      m_Items: []
  - m_Id: 1231806817
    m_Localized: Thieves at pumps within 12 m get caught more often.
    m_Metadata:
      m_Items: []
  - m_Id: 1231806818
    m_Localized: This is outside our lot
    m_Metadata:
      m_Items: []
  - m_Id: 1231806819
    m_Localized: Cars drive here or a building stands here
    m_Metadata:
      m_Items: []
  - m_Id: 1231806820
