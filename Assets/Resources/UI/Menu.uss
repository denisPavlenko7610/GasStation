/* Main menu, pause menu and settings (UI Toolkit). Loaded at runtime from Resources/UI/Menu. */
/* Style: warm retro-highway menu with glowing orange buttons. */

.menu-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 7, 12, 0.76);
}

.menu-overlay--main {
    align-items: flex-start;
    padding-left: 7%;
    background-color: rgba(6, 7, 12, 0.45);
}

.menu-window {
    min-width: 480px;
    padding: 26px 30px 24px 30px;
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    background-color: rgba(16, 18, 27, 0.96);
}

.menu-window--wide {
    width: 780px;
    max-height: 90%;
}

.menu-accent {
    height: 4px;
    width: 96px;
    margin-bottom: 16px;
    border-radius: 2px;
    background-color: rgb(245, 158, 66);
}

.menu-title {
    font-size: 62px;
    color: rgb(252, 250, 246);
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 2px 3px 4px rgba(0, 0, 0, 0.7);
}

.menu-subtitle {
    font-size: 20px;
    margin-bottom: 28px;
    color: rgb(245, 158, 66);
    letter-spacing: 1px;
}

.menu-heading {
    font-size: 34px;
    margin-bottom: 14px;
    color: rgb(252, 250, 246);
    -unity-font-style: bold;
}

.menu-section {
    font-size: 17px;
    margin-top: 18px;
    margin-bottom: 6px;
    color: rgb(245, 158, 66);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.menu-button {
    height: 52px;
    margin: 6px 0;
    padding-left: 18px;
    font-size: 22px;
    border-width: 0;
    border-left-width: 4px;
    border-left-color: rgba(245, 158, 66, 0.55);
    border-radius: 10px;
    color: rgb(245, 245, 245);
    -unity-text-align: middle-left;
    background-color: rgba(255, 255, 255, 0.07);
    transition-property: background-color, border-left-color, translate;
    transition-duration: 0.12s;
}

.menu-button:hover {
    background-color: rgba(245, 158, 66, 0.92);
    border-left-color: rgb(255, 214, 150);
    translate: 6px 0;
}

.menu-button:active {
    background-color: rgba(214, 122, 38, 1);
    translate: 2px 0;
}

.menu-button:disabled {
    opacity: 0.4;
}

.menu-button--small {
    height: 44px;
    min-width: 170px;
    margin-left: 10px;
    font-size: 19px;
    -unity-text-align: middle-center;
    padding-left: 0;
    border-left-width: 0;
}

.menu-button--small:hover {
    translate: 0 -2px;
}

.menu-buttons-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 18px;
}

.menu-footer {
    font-size: 14px;
    margin-top: 20px;
    color: rgb(138, 145, 158);
}

.menu-text {
    font-size: 19px;
    white-space: normal;
    color: rgb(226, 229, 235);
}

.settings-scroll {
    max-height: 640px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    margin: 2px 0;
    border-radius: 8px;
    padding: 0 8px;
}

.settings-row:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.settings-label {
    width: 44%;
    font-size: 18px;
    color: rgb(226, 229, 235);
}

.settings-control {
    width: 54%;
    margin: 0;
}

.name-field {
    margin-top: 14px;
    height: 46px;
    font-size: 22px;
}
