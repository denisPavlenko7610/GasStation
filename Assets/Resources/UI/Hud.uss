/* HUD of GasStation (UI Toolkit). Loaded at runtime from Resources/UI/Hud. */
/* Style: warm retro-highway glass cards with an orange accent edge. */

.hud-root {
    flex-grow: 1;
}

.card {
    position: absolute;
    background-color: rgba(12, 14, 22, 0.82);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-left-width: 4px;
    border-left-color: rgb(245, 158, 66);
    padding: 10px 14px 12px 14px;
}

.card--top-left { left: 18px; top: 18px; max-width: 34%; }
.card--top-right { right: 18px; top: 18px; max-width: 40%; border-left-color: rgb(96, 165, 250); }
.card--bottom-left { left: 18px; bottom: 18px; max-width: 48%; border-left-color: rgb(52, 211, 153); }
.card--bottom-right { right: 18px; bottom: 18px; max-width: 46%; border-left-color: rgba(255, 255, 255, 0.28); }
.card--top-center { top: 18px; left: 50%; translate: -50% 0; min-width: 320px; max-width: 42%; border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.10); }
.card--top-center.card--wide { max-width: 64%; }
.card--center {
    top: 55%;
    left: 37%;
    right: 37%;
    align-items: center;
    background-color: rgba(16, 18, 28, 0.9);
    border-color: rgba(245, 158, 66, 0.65);
    border-left-width: 1px;
    border-left-color: rgba(245, 158, 66, 0.65);
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    margin-top: -4px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.9);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.55);
}

.accent-line {
    height: 3px;
    width: 64px;
    margin-bottom: 10px;
    border-radius: 2px;
    background-color: rgb(245, 158, 66);
}

.hud-text {
    color: rgb(238, 240, 244);
    font-size: 17px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.hud-text--right { -unity-text-align: upper-right; }
.hud-text--small { font-size: 13px; color: rgb(178, 186, 200); }
.hud-text--center { font-size: 22px; -unity-text-align: middle-center; -unity-font-style: bold; }

.meter {
    flex-direction: row;
    align-items: center;
    margin-top: 7px;
}

.meter__label {
    width: 110px;
    font-size: 14px;
    color: rgb(178, 186, 200);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.meter__track {
    width: 180px;
    height: 12px;
    border-radius: 6px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.10);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

.meter__fill {
    height: 100%;
    width: 50%;
    border-radius: 6px;
    background-color: rgb(52, 211, 153);
}

.meter__fill--reputation { background-color: rgb(245, 158, 66); }
.meter__fill--xp { background-color: rgb(96, 165, 250); }

.quest-marker {
    position: absolute;
    width: 40px;
    font-size: 46px;
    color: rgb(255, 158, 44);
    -unity-text-align: lower-center;
    -unity-font-style: bold;
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.85);
}

.car-card {
    position: absolute;
    width: 150px;
    padding: 6px 9px 7px 9px;
    border-radius: 9px;
    background-color: rgba(12, 14, 22, 0.84);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-left-width: 3px;
    border-left-color: rgb(245, 158, 66);
}

.car-card__text {
    font-size: 14px;
    color: rgb(238, 240, 244);
    white-space: normal;
    -unity-text-align: middle-center;
}

.car-card__track {
    height: 6px;
    margin-top: 4px;
    border-radius: 3px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.14);
}

.car-card__fill {
    height: 100%;
    width: 100%;
    border-radius: 3px;
    background-color: rgb(52, 211, 153);
}

.chart {
    min-width: 480px;
    flex-direction: row;
    align-items: flex-end;
    height: 170px;
    margin-top: 12px;
    padding-top: 8px;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
}

.chart__column {
    flex-grow: 1;
    height: 100%;
    margin: 0 3px;
    align-items: center;
}

.chart__bars {
    flex-grow: 1;
    width: 100%;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.chart__bar {
    width: 40%;
    margin: 0 1px;
    border-radius: 3px;
}

.chart__bar--income { background-color: rgb(52, 211, 153); }
.chart__bar--expense { background-color: rgb(248, 113, 93); }

.chart__day {
    font-size: 12px;
    color: rgb(160, 168, 182);
}

/* Floating "+$12" lines by the money panel. */
.money-pop__layer {
    position: absolute;
    left: 20px;
    top: 14px;
}

.money-pop {
    color: rgb(110, 231, 148);
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    text-shadow: 1px 2px 2px rgba(0, 0, 0, 0.8);
}

.money-pop--expense {
    color: rgb(248, 113, 93);
}
